@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix m4i: <http://w3id.org/nfdi4ing/metadata4ing#> .

m4i:NumericalVariableShape a sh:NodeShape ;
    sh:targetClass m4i:NumericalVariable ;
    sh:property [ sh:path rdfs:label ; sh:minCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path m4i:hasNumericalValue ; sh:maxCount 1 ; sh:nodeKind sh:Literal ] ;
    sh:property [ sh:path m4i:hasStringValue ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path m4i:hasUnit ; sh:maxCount 1 ] ;
    sh:property [ sh:path m4i:hasKindOfQuantity ; sh:maxCount 1 ] .
