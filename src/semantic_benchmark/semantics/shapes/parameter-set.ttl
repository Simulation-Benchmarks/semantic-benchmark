@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix m4i: <http://w3id.org/nfdi4ing/metadata4ing#> .
@prefix obo: <http://purl.obolibrary.org/obo/> .

m4i:ParameterSetShape a sh:NodeShape ;
    sh:targetClass m4i:ParameterSet ;
    sh:property [ sh:path rdfs:label ; sh:minCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path m4i:identifier ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path obo:BFO_0000051 ; sh:minCount 1 ; sh:nodeKind sh:IRI ] .
