@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix cr: <http://mlcommons.org/croissant/> .
@prefix m4i: <http://w3id.org/nfdi4ing/metadata4ing#> .
@prefix sio: <http://semanticscience.org/resource/> .

cr:FieldShape a sh:NodeShape ;
    sh:targetClass cr:Field ;
    sh:property [ sh:path m4i:dataType ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path sio:SIO_000210 ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path cr:source ; sh:minCount 1 ; sh:maxCount 1 ; sh:class cr:DataSource ] .
