@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix cr: <http://mlcommons.org/croissant/> .

cr:DataSourceShape a sh:NodeShape ;
    sh:targetClass cr:DataSource ;
    sh:property [
        sh:path cr:extract ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:node [ sh:property [ sh:path cr:jsonPath ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ]
    ] ;
    sh:property [
        sh:path [ sh:alternativePath ( cr:fileObject cr:FileObject ) ] ;
        sh:minCount 1 ; sh:maxCount 1 ; sh:class cr:FileObject
    ] .
