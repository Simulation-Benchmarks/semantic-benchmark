@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix m4i: <http://w3id.org/nfdi4ing/metadata4ing#> .
@prefix mathmod: <https://mardi4nfdi.github.io/MathModDB/> .
@prefix schema: <https://schema.org/> .
@prefix wd: <http://www.wikidata.org/entity/> .

m4i:BenchmarkShape a sh:NodeShape ;
    sh:targetClass m4i:Benchmark ;
    sh:property [ sh:path rdfs:label ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path m4i:investigates ; sh:minCount 1 ; sh:maxCount 1 ; sh:class mathmod:ResearchProblem ] ;
    sh:property [ sh:path wd:P2283 ; sh:minCount 1 ; sh:maxCount 1 ; sh:class mathmod:MathematicalModel ] ;
    sh:property [ sh:path m4i:evaluates ; sh:minCount 1 ; sh:class m4i:NumericalVariable ] ;
    sh:property [ sh:path m4i:hasParameterSet ; sh:minCount 1 ; sh:class m4i:ParameterSet ] ;
    sh:property [ sh:path schema:version ; sh:maxCount 1 ; sh:datatype xsd:string ] .
